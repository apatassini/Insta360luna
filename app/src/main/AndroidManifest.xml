<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <!-- L'SSID serve soltanto a riconoscere l'access point della camera. -->
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" />
    <!--
        Android richiede ancora la posizione precisa per leggere SSID e BSSID dai risultati
        della scansione Wi-Fi. Quei dati servono esclusivamente a scegliere l'access point
        Luna esatto, evitando il selettore generico che fallisce su alcuni firmware OEM.
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!--
        Il tipo "connectedDevice" è quello giusto per una sessione verso una camera sulla
        propria rete Wi-Fi, ed è consentito perché l'app dichiara CHANGE_NETWORK_STATE.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <!--
        L'unione di una panoramica non è un dispositivo connesso: è calcolo che dura minuti e
        deve sopravvivere al cambio di applicazione. Da Android 14 il tipo va dichiarato e
        deve corrispondere a quello che il servizio sta davvero facendo.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Prima di Android 10 la galleria è una cartella pubblica e serve il permesso di scriverci. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!--
        Leggere le foto dove sono, invece di farne una copia.

        Una panoramica presa dalla galleria del telefono e` fatta di file che esistono gia`:
        copiarli vorrebbe dire occupare due volte lo stesso spazio per lavorarci sopra. Con
        questo permesso l'app apre gli originali dove stanno, in sola lettura, e non li tocca.
    -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Necessario per consegnare ad Android l'APK scaricato dalla release GitHub. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:allowBackup="true"
        android:largeHeap="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.LunaUltra">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:label="@string/app_name"
            android:theme="@style/Theme.LunaUltra">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Senza un servizio in primo piano il processo viene congelato pochi secondi dopo
            essere finito in background: il keep-alive si ferma e la camera chiude la sessione.
        -->
        <service
            android:name=".service.LunaConnectionService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice|dataSync" />

        <!--
            Serve a condividere il log esportato: un file nella cache privata dell'app non è
            leggibile da altre app, e passarlo come testo dentro l'intent supererebbe il limite
            della transazione appena il log si allunga.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
